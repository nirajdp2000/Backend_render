{
  "name": "stockpulse-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node --input-type=module -e \"import {build} from 'esbuild'; build({entryPoints:['server.ts'],bundle:true,platform:'node',target:'node20',format:'cjs',outfile:'dist/server.cjs',external:['better-sqlite3','fsevents']}).then(()=>console.log('Built'))\"",
    "start": "node dist/server.cjs",
    "dev": "tsx server.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.99.3",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.4.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "openai": "^6.32.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
