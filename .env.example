# ─── Upstox API Credentials (OAuth-based) ────────────────────────────────────
UPSTOX_CLIENT_ID=37381aec-8f2d-47da-a89b-ab9476dd15d7
UPSTOX_CLIENT_SECRET=tqfd41uqib
# IMPORTANT: Replace with your actual Render URL once deployed
# Must match EXACTLY what is registered in Upstox developer dashboard
UPSTOX_REDIRECT_URI=https://your-render-url.onrender.com/api/upstox/callback

# Pre-set access token (optional — used on Vercel where SQLite is unavailable)
# Get this from the Upstox developer portal or after completing OAuth locally
UPSTOX_ACCESS_TOKEN=

# ─── Gemini AI Credentials ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
API_KEY=

# ─── Supabase (optional but recommended for Vercel persistent storage) ────────
# Create a free project at https://supabase.com, then run the SQL schema from
# src/lib/supabase.ts in the Supabase SQL editor to create the required tables.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── Runtime ─────────────────────────────────────────────────────────────────
# Set to 'production' on Vercel / Railway / Render (auto-set by most platforms)
NODE_ENV=development

# Port for local Express server (default: 3000)
PORT=3000
